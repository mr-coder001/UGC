# Server Configuration
PORT=3000
NODE_ENV=development

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Persistent Database URL (PostgreSQL for Production / Vercel Postgres / Neon / Supabase)
# Leave empty for automatic local SQLite fallback during local development
DATABASE_URL=

# Express Session Secret
SESSION_SECRET=

# Cloudinary API Credentials (Server-Side Only - Never Exposed to Browser)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS Configuration
FRONTEND_ORIGIN=http://localhost:3000
